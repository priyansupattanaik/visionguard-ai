# VisionGuard Colab Fast-GPU profile
# Copy values into Colab Secrets / os.environ. Do not commit real keys.
#
# Goal: maximize throughput on a Colab GPU while keeping evidence-first answers.
# Detector object/count/temporal routes stay grounded. NVIDIA captions remain
# labeled semantic_description (never treated as verified facts).

VISION_GUARD_HOST=0.0.0.0
VISION_GUARD_PORT=7860
VISION_GUARD_OUT_DIR=output
VISION_GUARD_MODEL_DIR=.models
VISION_GUARD_CACHE_DIR=.cache/visionguard
VISION_GUARD_DEVICE=cuda
VISION_GUARD_SKIP_WARMUP=0
VISION_GUARD_LOCAL_MODELS_ONLY=0
VISION_GUARD_ALLOW_EMBEDDING_FALLBACK=0
VISION_GUARD_MAX_DURATION_SECONDS=90
VISION_GUARD_MAX_UPLOAD_MB=80
VISION_GUARD_MAX_VIDEOS=5

# Fast detector profile (GPU)
YOLO_MODEL=yolo11n.pt
YOLO_CONF=0.28
YOLO_IMGSZ=512
MIN_EVIDENCE_CONFIDENCE=0.35
MIN_VECTOR_SIMILARITY=0.20

# Embeddings: GPU batching, no per-crop embeddings
CLIP_MODEL=google/siglip2-so400m-patch14-384
IMAGE_BATCH_SIZE=16
ENABLE_CROP_EMBEDDINGS=0

# Fewer segments => fewer NVIDIA semantic API calls => much faster indexing
WIN_SEC=8.0
SEMANTIC_WORKERS=6
SEMANTIC_PROVIDER=nvidia
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VLM_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
NVIDIA_API_TIMEOUT=60
NVIDIA_API_KEY=

# No optional LLM reasoning / auto verification (reduces invented prose)
MODEL_PROVIDER=none
VERIFIER_READY_TIMEOUT=0
MAX_EXHAUSTIVE_VERIFICATION_FRAMES=8
