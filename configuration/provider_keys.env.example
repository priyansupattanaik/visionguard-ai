# Copy this file to provider_keys.env in the same folder.
# This file is read after the main .env file. Never commit real keys.

# Implemented optional visual-verification provider:
NVIDIA_API_KEY=

# Optional only when downloading gated Hugging Face models:
HF_TOKEN=

# OpenAI, Groq, Anthropic, and Gemini are not connected to the current runtime.
# Do not add their keys until a corresponding provider adapter is implemented.
