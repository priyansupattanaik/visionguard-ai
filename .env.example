# ==========================================
# VisionGuard Environment Configuration (.env)
# ==========================================

# Server Configuration
VISION_GUARD_HOST=127.0.0.1
VISION_GUARD_PORT=7860
VISION_GUARD_SKIP_WARMUP=0
VISION_GUARD_OUT_DIR=output

# Compute Device (cuda, cpu, or leave empty for auto-detection)
VISION_GUARD_DEVICE=

# Model Configurations
YOLO_MODEL=yolo11m.pt
YOLO_CONF=0.22
YOLO_IMGSZ=640
YOLO_TRACKER=botsort.yaml

CLIP_MODEL=google/siglip2-so400m-patch14-384
# Use cached Hugging Face retrieval/segmentation models and never make network checks.
# Set to 0 only while intentionally downloading or updating local retrieval models.
VISION_GUARD_LOCAL_MODELS_ONLY=1
SAM_MODEL=facebook/sam2.1-hiera-small

# NVIDIA hosted visual verification (required for API verification)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VLM_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
NVIDIA_API_TIMEOUT=30

# Scanning / indexing performance
# Increase SAMPLE_SEC to sample fewer frames and scan faster (recommended CPU value: 1.5).
SAMPLE_SEC=1.5
WIN_SEC=4.5
# Set to 0 to skip per-object SigLIP crop embeddings for a large scan-speed gain.
ENABLE_CROP_EMBEDDINGS=0
# Tune to available memory; larger batches improve embedding throughput.
IMAGE_BATCH_SIZE=24
# Detector and compute target used by tracking and embeddings.
YOLO_MODEL=yolo11m.pt
VISION_GUARD_DEVICE=

# HuggingFace API Token (optional, only for local SigLIP/SAM retrieval models)
# HF_TOKEN=your_huggingface_token_here
