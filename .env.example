# ==========================================
# VisionGuard Environment Configuration (.env)
# ==========================================
# Copy to .env and fill in secrets. Never commit real API keys.

# Server Configuration
VISION_GUARD_HOST=127.0.0.1
VISION_GUARD_PORT=7860
VISION_GUARD_SKIP_WARMUP=0
VISION_GUARD_OUT_DIR=output
VISION_GUARD_MODEL_DIR=.models
VISION_GUARD_CACHE_DIR=.cache/visionguard
VISION_GUARD_API_TOKEN=
VISION_GUARD_MAX_UPLOAD_MB=500
VISION_GUARD_MAX_DURATION_SECONDS=1800
VISION_GUARD_MAX_WIDTH=3840
VISION_GUARD_MAX_HEIGHT=2160
VISION_GUARD_MAX_VIDEOS=20
VISION_GUARD_RATE_LIMIT_PER_MINUTE=60
VISION_GUARD_DOWNLOAD_TTL_SECONDS=3600

# CPU-only portable execution; no CUDA-capable hardware is required.
VISION_GUARD_DEVICE=cpu

# ------------------------------
# Models
# ------------------------------
# Optional reasoning/visual-verification provider: llama_cpp | nvidia | groq | none
# `none` is the reliable local default; detection and semantic retrieval remain available.
MODEL_PROVIDER=none
LLAMA_CPP_TEXT_URL=http://127.0.0.1:8080
LLAMA_CPP_VISION_URL=http://127.0.0.1:8081
LLAMA_CPP_TEXT_MODEL=local
LLAMA_CPP_VISION_MODEL=local
LLAMA_CPP_TIMEOUT_SECONDS=120

# Fast: yolo11n.pt | Balanced: yolo11s.pt | Quality: yolo11m.pt
YOLO_MODEL=yolo11n.pt
YOLO_CONF=0.22
MIN_EVIDENCE_CONFIDENCE=0.25
MIN_VECTOR_SIMILARITY=0.14
YOLO_IMGSZ=640
YOLO_TRACKER=botsort.yaml

CLIP_MODEL=google/siglip2-so400m-patch14-384
# Use cached Hugging Face models only (no network). Set 0 to allow downloads.
VISION_GUARD_LOCAL_MODELS_ONLY=1
VISION_GUARD_ALLOW_EMBEDDING_FALLBACK=0
SAM_MODEL=facebook/sam2.1-hiera-small

# NVIDIA semantic indexing is mandatory. MODEL_PROVIDER remains independent and optional.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VLM_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
NVIDIA_API_TIMEOUT=30
NVIDIA_VERIFY_THRESHOLD=0.45
SEMANTIC_PROVIDER=nvidia
SEMANTIC_MIN_DWELL_SECONDS=2.0
# Operator-defined normalized regions. Example:
# VISION_GUARD_ZONES_JSON=[{"name":"gate","left":0.0,"top":0.2,"right":0.2,"bottom":0.9}]
VISION_GUARD_ZONES_JSON=[]
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=
GROQ_API_TIMEOUT=30
# Bounds API cost for open queries when semantic embeddings are unavailable.
MAX_EXHAUSTIVE_VERIFICATION_FRAMES=24
# Maximum time query requests wait for verifier warmup; 0 disables waiting.
VERIFIER_READY_TIMEOUT=30
VERIFIER_POLL_INTERVAL=0.25

# ------------------------------
# Scanning / indexing performance
# ------------------------------
# Every decoded frame is inspected. Only exact consecutive pixel duplicates are removed.
WIN_SEC=4.5

# Per-object SigLIP crop embeddings (expensive). Off for Fast/Balanced.
# Fast/Balanced: 0 | Quality: 1
ENABLE_CROP_EMBEDDINGS=0

# SigLIP image batch size. CPU: 4-8 | GPU: 16-32
IMAGE_BATCH_SIZE=16

# Optional HuggingFace token (only needed to download/update local models)
# HF_TOKEN=your_huggingface_token_here

# ------------------------------
# Recommended presets (copy values into the vars above)
# ------------------------------
# Indexing always processes every source frame. `WIN_SEC` controls only the
# duration used to aggregate retained evidence into retrieval segments.
